# ==============================================================================
# PayPilot — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the server:
#   cp .env.example .env     (Linux / macOS)
#   copy .env.example .env   (Windows PowerShell / Command Prompt)
#
# NOTE: PayPilot includes a zero-config DEMO MODE!
# The entire frontend and API suite will run locally even if all external
# API credentials (PayPal, Gemini, PostgreSQL) are omitted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=your-random-session-secret-change-in-production

# ------------------------------------------------------------------------------
# 2. AI Intelligence Engine (Google Gemini / Demo Provider)
# ------------------------------------------------------------------------------
# Provider choice: 'gemini' (live AI model) or 'demo' (deterministic offline mode)
AI_PROVIDER=gemini

# Google AI Studio Gemini API Key
# Sign up and get a free key at: https://aistudio.google.com/
# If omitted or invalid, PayPilot automatically falls back to the safe demo provider.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. PayPal Developer Sandbox (Invoicing & Checkout)
# ------------------------------------------------------------------------------
# Create a free sandbox app at: https://developer.paypal.com/dashboard/applications/sandbox
# If omitted, PayPal actions run in verified demo mode.
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (from Webhook configuration in PayPal Developer Dashboard)
# Optional: Leave empty to bypass webhook signature verification in local development.
PAYPAL_WEBHOOK_ID=YOUR_OPTIONAL_WEBHOOK_ID

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database (Neon Serverless / Local Postgres)
# ------------------------------------------------------------------------------
# Optional for demo mode (app uses built-in in-memory demo data when omitted).
# To enable persistent storage, create a free database at: https://neon.tech/
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/paypilot?sslmode=require
